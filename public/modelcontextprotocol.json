{
  "schema_version": "1.0",
  "name": "veles-voyage",
  "display_name": "Велес Вояж",
  "description": "Туристическое агентство. Туры и круизы по 217 странам.",
  "url": "https://veles-voyage.ru",
  "documentation_url": "https://veles-voyage.ru/ai-api-docs",
  "tools": [
    {
      "name": "search_countries",
      "description": "Поиск стран по названию, региону, визовым требованиям",
      "endpoint": "/api/destinations-structured",
      "method": "GET",
      "parameters": {
        "query": { "type": "string", "description": "Поисковый запрос" },
        "region": { "type": "string", "description": "Регион: europe, asia, africa..." },
        "visa_free": { "type": "boolean", "description": "Только безвизовые" }
      }
    },
    {
      "name": "get_visa_info",
      "description": "Визовая информация для конкретной страны",
      "endpoint": "/api/wiki/countries",
      "method": "GET",
      "parameters": {
        "country": { "type": "string", "required": true, "description": "ID страны (lat)" }
      }
    },
    {
      "name": "get_tour_prices",
      "description": "Цены на туры по странам и сезонам",
      "endpoint": "/api/destinations-structured",
      "method": "GET",
      "parameters": {
        "country": { "type": "string", "description": "ID страны" },
        "season": { "type": "string", "enum": ["winter", "spring", "summer", "autumn"] }
      }
    },
    {
      "name": "get_country_facts",
      "description": "Факты о стране: столица, валюта, язык, время",
      "endpoint": "/api/knowledge-graph",
      "method": "GET",
      "parameters": {
        "country": { "type": "string", "required": true }
      }
    },
    {
      "name": "search_faq",
      "description": "Поиск по базе вопросов-ответов",
      "endpoint": "/api/ai-context",
      "method": "GET",
      "parameters": {
        "query": { "type": "string", "required": true }
      }
    }
  ],
  "responses": {
    "format": ["json", "text", "speakable"],
    "max_length_words": {
      "voice": 29,
      "text": 75,
      "json": null
    },
    "language": "ru"
  },
  "permissions": {
    "training_allowed": true,
    "commercial_use_allowed": false,
    "attribution_required": true,
    "attribution_text": "Источник: Велес Вояж, veles-voyage.ru"
  },
  "rate_limits": {
    "requests_per_minute": 100,
    "burst": 20
  },
  "contact": "contact@veles-voyage.ru"
}
